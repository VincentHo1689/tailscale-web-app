import 'dart:async';
import 'dart:convert';
import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_dotenv/flutter_dotenv.dart';
import 'package:flutter_inappwebview/flutter_inappwebview.dart';
import 'package:path_provider/path_provider.dart';
import 'package:tailscale/tailscale.dart';
import 'package:url_launcher/url_launcher.dart';

const _proxyChannel = MethodChannel('__APP_PACKAGE__/webview_proxy');

void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await dotenv.load(fileName: '.env');
  runApp(const TailscaleWebApp());
}

class TailscaleWebApp extends StatefulWidget {
  const TailscaleWebApp({super.key});

  @override
  State<TailscaleWebApp> createState() => _TailscaleWebAppState();
}

class _TailscaleWebAppState extends State<TailscaleWebApp> {
  TailscaleClient? _tsnet;
  Uri? _loginUrl;
  String? _error;
  bool _loading = true;
  bool _openingLogin = false;
  bool _restartingLogin = false;
  bool _ready = false;
  LocalForwardProxy? _proxy;
  InAppWebViewController? _webController;
  StreamSubscription<NodeState>? _stateSub;
  Timer? _reloadTimer;
  Timer? _watchdog;
  int _reloadAttempts = 0;
  DateTime? _lastReloadAt;
  bool _tsConnected = false;
  bool _pageReady = false;
  bool _loadErrored = false;
  PullToRefreshController? _pullToRefresh;

  Color _statusBarColor = Colors.black;
  Brightness _statusBarIconBrightness = Brightness.light;

  String get _appName => dotenv.env['APP_NAME']?.trim() ?? 'Tailscale Web App';
  String get _packageName =>
      dotenv.env['APP_PACKAGE']?.trim() ?? 'com.example.tailscalewebapp';
  String get _hostname =>
      dotenv.env['TAILSCALE_HOSTNAME']?.trim() ?? 'TailscaleWebApp';
  String get _webUrl => dotenv.env['WEB_URL']?.trim() ?? '';

  @override
  void initState() {
    super.initState();
    final statusBarHex = dotenv.env['STATUS_BAR_COLOR'];
    if (statusBarHex != null && statusBarHex.isNotEmpty) {
      _statusBarColor = _hexToColor(statusBarHex);
      _statusBarIconBrightness = _statusBarColor.computeLuminance() > 0.5
          ? Brightness.dark
          : Brightness.light;
    }
    SystemChrome.setSystemUIOverlayStyle(
      SystemUiOverlayStyle(
        statusBarColor: _statusBarColor,
        statusBarIconBrightness: _statusBarIconBrightness,
        statusBarBrightness: _statusBarIconBrightness == Brightness.light
            ? Brightness.dark
            : Brightness.light,
      ),
    );
    _pullToRefresh = PullToRefreshController(
      settings: PullToRefreshSettings(color: _statusBarColor),
      onRefresh: _reloadFromPull,
    );
    _connect();
  }

  Future<void> _connect() async {
    try {
      final target = Uri.tryParse(_webUrl);
      if (target == null || !target.hasScheme || target.host.isEmpty) {
        throw const FormatException(
          'WEB_URL must be a complete HTTP or HTTPS URL.',
        );
      }
      if (target.scheme != 'http' && target.scheme != 'https') {
        throw const FormatException('WEB_URL must use HTTP or HTTPS.');
      }

      final directory = await getApplicationDocumentsDirectory();
      Tailscale.init(
        appId: _packageName,
        stateDir: '${directory.path}/tailscale_state',
        logLevel: TailscaleLogLevel.info,
      );
      final tsnet = Tailscale.instance;
      _tsnet = tsnet;
      _stateSub = tsnet.onStateChange.listen(_onTailscaleState);
      final status = await tsnet.up(hostname: _hostname);

      if (!mounted) return;
      if (status.needsLogin) {
        setState(() {
          _loading = false;
          _loginUrl = status.authUrl;
        });
        if (status.authUrl != null) {
          await _openLogin(status.authUrl!);
        }
        _waitForConnection();
      } else if (status.isRunning) {
        await _showWebView(tsnet, target);
      } else {
        throw StateError('Tailscale is not ready: ${status.state}.');
      }
    } catch (error) {
      if (mounted) {
        setState(() {
          _loading = false;
          _error = error.toString();
        });
      }
    }
  }

  Color _hexToColor(String hex) {
    hex = hex.replaceAll('#', '');
    if (hex.length == 6) hex = 'FF$hex';
    return Color(int.parse(hex, radix: 16));
  }

  Future<void> _openLogin(Uri url) async {
    if (_openingLogin) return;
    _openingLogin = true;
    final opened = await launchUrl(url, mode: LaunchMode.externalApplication);
    if (!opened && mounted) {
      setState(() => _error = 'Could not open the Tailscale login page.');
    }
  }

  Future<void> _waitForConnection() async {
    final tsnet = _tsnet;
    if (tsnet == null) return;
    while (mounted && !_ready) {
      await Future<void>.delayed(const Duration(seconds: 2));
      final status = await tsnet.status();
      if (!mounted) return;
      if (status.isRunning) {
        final target = Uri.parse(_webUrl);
        await _showWebView(tsnet, target);
        return;
      }
      if (status.needsLogin && status.authUrl != null) {
        final isNewLoginUrl = status.authUrl != _loginUrl;
        if (isNewLoginUrl) {
          setState(() => _loginUrl = status.authUrl);
          _openingLogin = false;
          await _openLogin(status.authUrl!);
        }
      }
      if (status.state == NodeState.needsMachineAuth) {
        setState(() {
          _loading = false;
          _error = 'This device needs approval in the Tailscale admin console.';
        });
        return;
      }
    }
  }

  void _onTailscaleState(NodeState state) {
    final connected = state == NodeState.running;
    final becameConnected = connected && !_tsConnected;
    _tsConnected = connected;
    if (!becameConnected || !_ready) return;
    final last = _lastReloadAt;
    if (last != null &&
        DateTime.now().difference(last) < const Duration(seconds: 10)) {
      return;
    }
    _reloadAttempts = 0;
    _pageReady = false;
    if (mounted) setState(() {});
    _scheduleReload();
  }

  void _reloadFromPull() {
    _reloadAttempts = 0;
    _loadErrored = false;
    if (mounted) setState(() => _pageReady = false);
    _webController?.loadUrl(urlRequest: URLRequest(url: WebUri(_webUrl)));
    _pullToRefresh?.endRefreshing();
  }

  void _startWatchdog() {
    _watchdog?.cancel();
    _watchdog = Timer.periodic(const Duration(seconds: 1), (_) {
      if (!_pageReady && !(_reloadTimer?.isActive ?? false)) {
        _scheduleReload();
      }
    });
  }

  void _scheduleReload() {
    if (_reloadTimer?.isActive ?? false) return;
    final seconds = _reloadAttempts >= 5 ? 30 : 1 << _reloadAttempts;
    _reloadAttempts++;
    _reloadTimer = Timer(Duration(seconds: seconds), () {
      _reloadTimer = null;
      _lastReloadAt = DateTime.now();
      _webController?.loadUrl(
        urlRequest: URLRequest(url: WebUri(_webUrl)),
      );
    });
  }

  Future<void> _restartLogin() async {
    if (_restartingLogin || _tsnet == null) return;
    setState(() {
      _error = null;
      _loading = true;
      _loginUrl = null;
    });
    _restartingLogin = true;
    try {
      final tsnet = _tsnet!;
      await tsnet.down();
      final status = await tsnet.up(hostname: _hostname);
      if (!mounted) return;
      if (status.isRunning) {
        await _showWebView(tsnet, Uri.parse(_webUrl));
      } else if (status.needsLogin && status.authUrl != null) {
        setState(() {
          _loading = false;
          _loginUrl = status.authUrl;
        });
        _openingLogin = false;
        await _openLogin(status.authUrl!);
      } else {
        throw StateError('Tailscale is not ready: ${status.state}.');
      }
    } catch (error) {
      if (mounted) {
        setState(() {
          _loading = false;
          _error = error.toString();
        });
      }
    } finally {
      _restartingLogin = false;
    }
  }

  Future<void> _showWebView(TailscaleClient tsnet, Uri target) async {
    if (_ready) return;
    final proxy = LocalForwardProxy(tsnet);
    await proxy.start();
    await _proxyChannel.invokeMethod<void>('setProxy', {
      'host': InternetAddress.loopbackIPv4.host,
      'port': proxy.port,
    });
    _proxy = proxy;
    if (!mounted) return;
    setState(() {
      _loading = false;
      _loginUrl = null;
      _ready = true;
    });
  }

  @override
  void dispose() {
    _stateSub?.cancel();
    _reloadTimer?.cancel();
    _watchdog?.cancel();
    _pullToRefresh?.dispose();
    _proxyChannel.invokeMethod<void>('clearProxy');
    _proxy?.close();
    _tsnet?.down();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnnotatedRegion<SystemUiOverlayStyle>(
      value: SystemUiOverlayStyle(
        statusBarColor: _statusBarColor,
        statusBarIconBrightness: _statusBarIconBrightness,
        statusBarBrightness: _statusBarIconBrightness == Brightness.light
            ? Brightness.dark
            : Brightness.light,
      ),
      child: MaterialApp(
        title: _appName,
        debugShowCheckedModeBanner: false,
        home: Scaffold(
          backgroundColor: _statusBarColor,
          body: SafeArea(
            top: true,
            bottom: false,
            child: _ready
                ? Stack(
                    children: [
                      InAppWebView(
                        initialUrlRequest: URLRequest(url: WebUri(_webUrl)),
                        pullToRefreshController: _pullToRefresh,
                        onWebViewCreated: (controller) {
                          _webController = controller;
                          _startWatchdog();
                        },
                        onLoadStart: (controller, url) => _loadErrored = false,
                        onLoadStop: (controller, url) {
                          _pullToRefresh?.endRefreshing();
                          if (_loadErrored) return;
                          _reloadAttempts = 0;
                          if (!_pageReady && mounted) {
                            setState(() => _pageReady = true);
                          }
                        },
                        onReceivedError: (controller, request, error) {
                          if (request.isForMainFrame != false &&
                              !error.description
                                  .toLowerCase()
                                  .contains('abort')) {
                            _loadErrored = true;
                            _scheduleReload();
                          }
                        },
                        onReceivedHttpError:
                            (controller, request, response) {
                              if (request.isForMainFrame != false &&
                                  (response.statusCode ?? 0) >= 500) {
                                _loadErrored = true;
                                _scheduleReload();
                              }
                            },
                      ),
                      if (!_pageReady)
                        Positioned.fill(
                          child: Container(
                            color: _statusBarColor,
                            child: const Center(
                              child: CircularProgressIndicator(),
                            ),
                          ),
                        ),
                    ],
                  )
                : Center(
                    child: _error != null
                        ? Padding(
                            padding: const EdgeInsets.all(24),
                            child: Text(_error!, textAlign: TextAlign.center),
                          )
                        : _loginUrl != null
                        ? Column(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              const Text(
                                'Complete Tailscale login in your browser.',
                              ),
                              const SizedBox(height: 16),
                              ElevatedButton(
                                onPressed: _restartingLogin
                                    ? null
                                    : _restartLogin,
                                child: const Text('Open fresh login'),
                              ),
                            ],
                          )
                        : _loading
                        ? const CircularProgressIndicator()
                        : const Text('Waiting for Tailscale connection...'),
                  ),
          ),
        ),
      ),
    );
  }
}

class LocalForwardProxy {
  LocalForwardProxy(this._tsnet);

  final TailscaleClient _tsnet;
  ServerSocket? _server;

  int get port => _server!.port;

  Future<void> start() async {
    _server = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
    _server!.listen(_handleClient);
  }

  Future<void> close() async {
    await _server?.close();
    _server = null;
  }

  static const _maxHeader = 64 * 1024;

  /// Raw L4 tunnel: parse only the request line, forward every other byte
  /// untouched. Never hands a CONNECT authority to Dart's Uri parser, which
  /// rejects IP authorities like `100.64.64.2:8888`.
  Future<void> _handleClient(Socket client) async {
    final clientIn = StreamController<List<int>>();
    final headReady = Completer<List<int>>();
    var head = <int>[];
    var readingHead = true;
    late StreamSubscription<Uint8List> sub;
    sub = client.listen(
      (chunk) {
        if (readingHead) {
          head.addAll(chunk);
          final end = _indexOf(head, const [13, 10, 13, 10]);
          if (end < 0) {
            if (head.length > _maxHeader) {
              readingHead = false;
              if (!headReady.isCompleted) {
                headReady.completeError('Request header too large.');
              }
              client.destroy();
            }
            return;
          }
          readingHead = false;
          final block = head.sublist(0, end + 4);
          final rest = head.sublist(end + 4);
          if (rest.isNotEmpty) clientIn.add(rest);
          if (!headReady.isCompleted) headReady.complete(block);
          return;
        }
        clientIn.add(chunk);
      },
      onError: (_) {
        if (!headReady.isCompleted) headReady.completeError('Client error.');
      },
      onDone: () {
        if (!headReady.isCompleted) headReady.completeError('Client closed.');
        if (!clientIn.isClosed) clientIn.close();
      },
    );

    TailscaleConnection? conn;
    var committed = false;
    try {
      final block = await headReady.future.timeout(
        const Duration(seconds: 30),
        onTimeout: () =>
            throw TimeoutException('Request header timeout.'),
      );
      final lineEnd = _indexOf(block, const [13, 10]);
      if (lineEnd < 0) throw const FormatException('Missing request line.');
      final requestLine = latin1.decode(block.sublist(0, lineEnd));
      final first = requestLine.indexOf(' ');
      final last = requestLine.lastIndexOf(' ');
      if (first <= 0 || last <= first) {
        throw const FormatException('Malformed request line.');
      }
      final method = requestLine.substring(0, first);
      final target = requestLine.substring(first + 1, last);
      final version = requestLine.substring(last + 1);
      final headers = latin1
          .decode(block.sublist(lineEnd + 2, block.length - 2))
          .split('\r\n');

      final isConnect = method == 'CONNECT';
      final dest = isConnect ? _authority(target) : _target(target, headers);
      final upstream = await _dial(dest);
      conn = upstream;
      committed = true;
      if (isConnect) {
        client.add('HTTP/1.1 200 Connection Established\r\n\r\n'.codeUnits);
      } else {
        upstream.output.write(
          utf8.encode(_originHead(method, version, headers, dest)),
        );
      }

      final toRemote = clientIn.stream.listen(
        (bytes) => upstream.output.write(bytes),
        onDone: upstream.output.close,
        cancelOnError: true,
      );
      final toLocal = upstream.input.listen(
        client.add,
        onDone: client.close,
        cancelOnError: true,
      );
      try {
        await client.done;
      } finally {
        await toRemote.cancel();
        await toLocal.cancel();
      }
    } catch (error) {
      if (!committed) {
        final body = 'Tailscale proxy error: $error';
        try {
          client.add(utf8.encode(
            'HTTP/1.1 502 Bad Gateway\r\n'
            'Content-Length: ${body.length}\r\n'
            'Connection: close\r\n\r\n$body',
          ));
        } catch (_) {}
      }
    } finally {
      await sub.cancel();
      if (!clientIn.isClosed) await clientIn.close();
      if (conn != null) {
        try {
          await conn.abort();
        } catch (_) {}
      }
      client.destroy();
    }
  }

  /// authority-form target of a CONNECT: `host:port`, `host`, or `[v6]:port`.
  Uri _authority(String authority) {
    var host = authority;
    var port = 443;
    if (authority.startsWith('[')) {
      final close = authority.indexOf(']');
      host = authority.substring(1, close < 0 ? authority.length : close);
      final rest = close < 0 ? '' : authority.substring(close + 1);
      if (rest.startsWith(':') && rest.length > 1) {
        port = int.parse(rest.substring(1));
      }
    } else {
      final colon = authority.lastIndexOf(':');
      if (colon > 0) {
        host = authority.substring(0, colon);
        port = int.parse(authority.substring(colon + 1));
      }
    }
    return Uri(scheme: 'https', host: host, port: port);
  }

  Uri _target(String target, List<String> headers) {
    if (target.contains('://')) return Uri.parse(target);
    String? host;
    for (final line in headers) {
      final colon = line.indexOf(':');
      if (colon > 0 && line.substring(0, colon).trim().toLowerCase() == 'host') {
        host = line.substring(colon + 1).trim();
        break;
      }
    }
    if (host == null || host.isEmpty) {
      throw const FormatException('Proxy request has no Host header.');
    }
    return Uri.parse('http://$host${target.isEmpty ? '/' : target}');
  }

  String _originHead(
    String method,
    String version,
    List<String> headers,
    Uri dest,
  ) {
    final path = dest.path.isEmpty ? '/' : dest.path;
    final target = dest.hasQuery ? '$path?${dest.query}' : path;
    final buffer = StringBuffer('$method $target $version\r\n');
    for (final line in headers) {
      if (line.isEmpty) continue;
      final colon = line.indexOf(':');
      final name = (colon > 0 ? line.substring(0, colon) : line)
          .trim()
          .toLowerCase();
      if (name == 'proxy-connection' || name == 'proxy-authorization') continue;
      buffer.write('$line\r\n');
    }
    return '$buffer\r\n';
  }

  Future<TailscaleConnection> _dial(Uri target) {
    return _tsnet.tcp.dial(
      target.host,
      target.hasPort
          ? target.port
          : target.scheme == 'https'
          ? 443
          : 80,
      timeout: const Duration(seconds: 15),
    );
  }

  int _indexOf(List<int> bytes, List<int> needle, [int start = 0]) {
    for (var i = start; i <= bytes.length - needle.length; i++) {
      var matches = true;
      for (var j = 0; j < needle.length; j++) {
        if (bytes[i + j] != needle[j]) {
          matches = false;
          break;
        }
      }
      if (matches) return i;
    }
    return -1;
  }
}
